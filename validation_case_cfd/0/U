FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    axis
    {
        type            empty;
    }

    inlet
    {
        type            fixedValue;
        // Calculation for Q = 4.8 L/min = 8.0e-5 m3/s, rho = 1000 kg/m3 (water)
        // Nozzle D = 1 mm (r = 0.5 mm) -> Area A = pi * (0.0005)^2 = 7.85398e-7 m2
        // U = Q / A = 8.0e-5 / (7.85398e-7) ≈ 101.86 m/s
        value           uniform (101.86 0 0);
    }

    walls
    {
        type            noSlip;
    }

    atmosphere
    {
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0);
    }

    front
    {
        type            wedge;
    }

    back
    {
        type            wedge;
    }
}


